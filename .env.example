# ===========================================
# Web App (Firebase Client)
# ===========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===========================================
# Firebase Admin (API routes / WhatsApp bot)
# Pilih salah satu: (A) env vars atau (B) file path
# ===========================================
# (A) Dari Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# (B) Atau path ke file JSON service account (lokal / server)
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json

# ===========================================
# WhatsApp Webhook
# ===========================================
# Token untuk verifikasi webhook (GET) — buat string rahasia sendiri
WHATSAPP_VERIFY_TOKEN=

# Nanti: token untuk kirim balasan (tergantung provider)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ===========================================
# Telegram Bot (laporan IoT error dari leader)
# ===========================================
# Dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Opsional: rahasia untuk init counter device (POST /api/admin/init-device-aggregation tanpa login)
# INIT_AGGREGATION_SECRET=

# ===========================================
# Cloudinary (upload foto/media repair IoT)
# ===========================================
# Dari Cloudinary Dashboard: Cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Upload preset: buat di Settings > Upload > Add upload preset, set "Signing Mode" = Unsigned
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
