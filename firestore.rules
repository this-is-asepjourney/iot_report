rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to get user factory access
    function getUserFactoryAccess() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.factory_access;
    }
    
    // Helper function to check if user has access to factory
    function hasFactoryAccess(factory) {
      return request.auth != null && (
        getUserRole() == 'admin' || 
        factory in getUserFactoryAccess()
      );
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users can update their own data
      allow update: if request.auth != null && request.auth.uid == userId;
      // Admin can read all users
      allow read: if request.auth != null && getUserRole() == 'admin';
      // Admin can create/update/delete users
      allow write: if request.auth != null && getUserRole() == 'admin';
    }
    
    // Devices collection
    match /devices/{deviceId} {
      // All authenticated users can read devices (filtered by factory_access in app)
      allow read: if request.auth != null;
      // All authenticated users can create devices
      allow create: if request.auth != null;
      // Only supervisor and admin can update devices
      allow update: if request.auth != null && 
        (getUserRole() in ['supervisor', 'admin']);
      // Only admin can delete devices
      allow delete: if request.auth != null && getUserRole() == 'admin';
    }
    
    // Repairs collection
    match /repairs/{repairId} {
      // All authenticated users can read repairs
      allow read: if request.auth != null;
      // All authenticated users can create repairs
      allow create: if request.auth != null;
      // Only supervisor and admin can update repairs
      allow update: if request.auth != null && 
        (getUserRole() in ['supervisor', 'admin']);
    }
    
    // Installations collection
    match /installations/{installationId} {
      // All authenticated users can read installations
      allow read: if request.auth != null;
      // All authenticated users can create installations
      allow create: if request.auth != null;
      // Only supervisor and admin can update installations
      allow update: if request.auth != null && 
        (getUserRole() in ['supervisor', 'admin']);
    }
    
    // Replacements (riwayat ganti IoT)
    match /replacements/{replacementId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Aggregations (counter docs untuk dashboard — ditulis oleh Cloud Functions / init API)
    match /aggregations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
