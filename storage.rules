rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to get user role
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // CSV imports folder - only supervisor and admin
    match /csv-imports/{fileName} {
      allow read: if request.auth != null && 
        (getUserRole() in ['supervisor', 'admin']);
      allow write: if request.auth != null && 
        (getUserRole() in ['supervisor', 'admin']);
    }
    
    // Repair photos folder - all authenticated users
    match /repairs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Device photos folder - all authenticated users
    match /devices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default: authenticated users can read/write
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
